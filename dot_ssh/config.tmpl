{{- if and (eq .chezmoi.os "darwin") (stat (joinPath .chezmoi.homeDir ".colima" "ssh_config")) }}
Include {{ joinPath .chezmoi.homeDir ".colima" "ssh_config" }}

{{- end }}
AddKeystoAgent yes
CanonicalizeHostname yes
ForwardAgent yes
SetEnv TERM=xterm-256color
ServerAliveInterval 60
ServerAliveCountMax 10
TCPKeepAlive yes

Include config.d/*

Host localhost
	StrictHostKeyChecking no
	UserKnownHostsFile=/dev/null

