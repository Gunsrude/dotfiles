# Theme
ZSH_THEMES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/themes"
ZSH_THEME="oxide"
source "$ZSH_THEMES_DIR/$ZSH_THEME.zsh-theme"

# SetOpts
setopt completealiases
setopt inc_append_history
setopt share_history
setopt autocd
setopt autopushd
setopt completeinword
setopt correct
setopt histexpiredupsfirst
setopt histignorealldups
setopt histignorespace
setopt interactive

# Keyboard
bindkey -e
source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/zkbd"

# History Setting
HISTFILE=~/.zsh_history
HISTSIZE=10010
SAVEHIST=10000

# Completions
zstyle ':completion:*' menu select
autoload -Uz compinit && compinit
autoload -U +X bashcompinit && bashcompinit
autoload -Uz promptinit && promptinit
complete -o nospace -C /usr/bin/vault vault

# MAKE environment
{{ if eq .chezmoi.os "linux" }}
MAKEFLAGS="-j$(nproc)"
{{ else }}
MAKEFLAGS="-j$(sysctl -n hw.ncpu)"
{{ end }}

{{- if not .is_container }}
{{- if eq .chezmoi.os "linux" }}
export SSH_AUTH_SOCK="$HOME/.local/share/ssh/ssh-agent.socket"
{{- end }}
export DOTFILES_REPO="https://codeberg.org/Gunsrude/dotfiles.git"
{{- end }}

# Goose AI agent
export GOOSE_PROVIDER=openai
export GOOSE_MODEL=qwen-full
export OPENAI_HOST=http://llm.stellar.build:8080
export OPENAI_BASE_PATH=v1/chat/completions
export OPENAI_API_KEY=not-needed
export GOOSE_LEAD_PROVIDER=openai
export GOOSE_LEAD_MODEL=qwen-small
export GOOSE_PLANNER_PROVIDER=openai
export GOOSE_PLANNER_MODEL=qwen-small
export GOOSE_TELEMETRY_ENABLED=false
export GOOSE_AUTO_COMPACT_THRESHOLD=0.7
export GOOSE_CONTEXT_LIMIT=131072
export GOOSE_PLANNER_CONTEXT_LIMIT=32768

# Dotfiles stuffs
alias c=chezmoi

# docker stuff
dockerrm() {
    docker container stop $1 && docker container rm $1
}

# Aliases
# env
{{- if eq .chezmoi.os "linux" }}
alias sdl="env -u SDL_VIDEODRIVER"
alias xforce="SDL_VIDEODRIVER=x11"
{{- end }}

# yay fixes
{{- if eq .chezmoi.os "linux" }}
alias yay='MAKEFLAGS="-j$(nproc)" yay --sudoloop'
alias mirrorup='sudo reflector --latest 20 --protocol https --sort rate --save /etc/pacman.d/mirrorlist -n 8 -c US --threads 8'
{{- end }}

{{ if eq .chezmoi.os "linux" }}
alias ls='ls --time-style=long-iso'
{{ else }}
alias ls='ls -lF'
{{ end }}
alias followthewhiterabbit="kitty --class kitty-matrix --config ~/.config/kitty/matrix.conf --start-as fullscreen -- tmatrix -f 0.1,2 -g 10,40"

# Wine32 Default
alias wine32='WINEPREFIX=~/.local/share/wineprefixes/win32 WINEARCH="win32"'

# Text Editor of choice
alias vi='nvim'
alias vim='nvim'
alias ni='nvim'
alias nano='nvim'
export EDITOR=nvim
alias :q='exit'
alias e='nvim .'
function vsclear {
    rm -f ~/.local/share/nvim/sessions/*
    rm -f ~/.local/state/nvim/sessions/*
    rm -rf ~/.cache/nvim
}

# Python
alias venv='python -m venv'

# Dev stuff
alias devvim='devcontainer exec --workspace-folder . vim .'
alias devdown='docker rm -f $(docker ps -aq --filter "label=devcontainer.local_folder=$(pwd)")'
alias devup='devcontainer up \
  --workspace-folder . \
  --dotfiles-repository https://codeberg.org/Gunsrude/dotfiles \
  --dotfiles-install-command install.sh \
  --mount "type=bind,source=${SSH_AUTH_SOCK},target=/tmp/ssh-agent.sock" \
  --remote-env SSH_AUTH_SOCK=/tmp/ssh-agent.sock'
alias devrebuild='devdown && devup --remove-existing-container --build-no-cache'

# Other Stuff
alias s='source ${HOME}/.zshrc'
alias z='vim ${HOME}/.zshrc'
alias neofetch='neofetch --color_blocks off'
alias powershell=pwsh
alias pwsh=pwsh /nologo
function mc {
    mkdir $1
    cd $1
}
alias fucking='sudo'

# Def some chicken and egg stuff going on here
function dotsetup() {
  local remote="${1:?Usage: dotsetup <remote-host>}"
  ssh "$remote" "sh -c \"\$(curl -fsLS get.chezmoi.io)\" -- init --apply $DOTFILES_REPO"
}

function fuck() {
  local app_name=$1

  for i in $(ps aux | grep -i "$app_name" | grep -v grep | awk '{print $2}');do
    sudo kill -9 $i
  done
}

# PATH
{{- if and (eq .chezmoi.os "darwin") (not .is_container) }}
if [ -d "/opt/homebrew/bin" ]; then path+=("/opt/homebrew/bin"); fi
if [ -d "${HOME}/Library/Python/3.9/bin" ]; then path+=("${HOME}/Library/Python/3.9/bin"); fi
{{- end }}
if [ -d "${HOME}/.local/bin" ]; then path+=("${HOME}/.local/bin"); fi
if [ -d "${HOME}/bin" ]; then path+=("${HOME}/bin"); fi
#export PATH

# Dummy API key for opencode-voice (ollama doesn't authenticate, but plugin requires a value)
export OLLAMA_API_KEY="ollama"
export HINDSIGHT_DYNAMIC_BANK_ID=true

function set_terminal_title() {
    local user_host="%n@%m"
    local current_dir="%~"
    print -Pn "\e]0;$user_host\a"
}

# Add workstation specific things like WSL settings
if [[ -f ~/.zshrc.local ]]; then
    source ~/.zshrc.local
fi

if [[ -d "$HOME/.nvm" ]]; then
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
fi

precmd_functions+=(set_terminal_title)

# Opencode CLI
if [[ -d "$HOME/.opencode/bin" ]]; then
    export PATH="$HOME/.opencode/bin:$PATH"
fi

