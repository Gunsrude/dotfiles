#!/usr/bin/env tmux
# =============================================================================
# This file is a template - machine-specific settings are applied via
# chezmoi using {{ .machine_type }} (work/personal/server/container)
# =============================================================================

# -----------------------------------------------------------------------------
# Plugin Manager (TPM)
# -----------------------------------------------------------------------------
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'catppuccin/tmux'
set -g @plugin 'tmux-plugins/tmux-battery'

# -----------------------------------------------------------------------------
# Catppuccin Configuration
# -----------------------------------------------------------------------------
set -g @catppuccin_flavor 'mocha'
set -g @catppuccin_window_status_style 'rounded'

# Load Catppuccin theme (must be done before using its status modules)
run '~/.tmux/plugins/catppuccin/tmux/catppuccin.tmux'

# -----------------------------------------------------------------------------
# User Preferences
# -----------------------------------------------------------------------------

# Mouse support
set -g mouse on

# Base index (1-based windows and panes)
set -g base-index 1
setw -g pane-base-index 1

# Scrollback buffer
set -g history-limit 50000

# Default terminal with fallback
if-shell "infocmp tmux-256color >/dev/null 2>&1" \
    "set -g default-terminal 'tmux-256color'" \
    "set -g default-terminal 'xterm-256color'"

# True color + extended keys (CSI u) for the OUTER terminal
# (kitty reports xterm-kitty; ssh clients typically report xterm-256color)
set -as terminal-features ',xterm-kitty:RGB,xterm-256color:RGB'
set -as terminal-features ',xterm-kitty:extkeys'

# Forward modified keys (Shift+Enter, Alt+Backspace) to panes even when the
# inner app does not opt in — fixes hit-or-miss Shift+Enter in TUI apps.
set -s extended-keys always
set -s extended-keys-format csi-u

# Prefix key (Ctrl-a instead of Ctrl-b)
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# Vi mode keys in copy/escape mode
set-window-option -g mode-keys vi
bind-key -T copy-mode-vi Enter send-keys -X copy-selection-and-cancel

# Emergency toggle to disable mouse tracking if terminal starts spewing garbage sequences
bind-key M set -g mouse off \; display-message "Mouse tracking disabled"

# Low escape-time so multi-byte sequences (alt+backspace, shift+enter) are
# not split/misread. Kitty sends these fast; 10ms is safe for local use.
set -sg escape-time 10

# Clipboard settings
set -g set-clipboard external

# -----------------------------------------------------------------------------
# Status Bar Configuration
# -----------------------------------------------------------------------------
# Status bar refresh interval
set -g status-interval 5
set -g status-justify left

# Status bar configuration
set -g status-left-length 100
set -g status-right-length 100

# Status bar content
set -g status-left ""
set -g status-right "#{E:@catppuccin_status_application}"
set -ag status-right "#{E:@catppuccin_status_session}"
set -ag status-right "#{E:@catppuccin_status_uptime}"
{{- if and (not .is_container) (index . "has_battery") }}
set -agF status-right "#{E:@catppuccin_status_battery}"
{{- end }}
set -ga status-right "#[bg=#{@thm_bg},fg=#{@thm_blue}] 󰭦 %Y-%m-%d 󰅐 %H:%M "

# -----------------------------------------------------------------------------
# Custom Keybindings
# -----------------------------------------------------------------------------
# Split panes with vi-style keys (h/j/k/l)
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# Resize panes with Ctrl+arrow keys
bind C-h resize-pane -L 5
bind C-j resize-pane -D 5
bind C-k resize-pane -U 5
bind C-l resize-pane -R 5

# Switch windows with Ctrl+number
bind C-1 select-window -t :1
bind C-2 select-window -t :2
bind C-3 select-window -t :3
bind C-4 select-window -t :4
bind C-5 select-window -t :5
bind C-6 select-window -t :6
bind C-7 select-window -t :7
bind C-8 select-window -t :8
bind C-9 select-window -t :9

# Join panes interactively via choose-tree
# H: Join selected pane horizontally into current pane
# V: Join selected pane vertically into current pane
bind-key H choose-tree "join-pane -h -s '%%'"
bind-key V choose-tree "join-pane -v -s '%%'"

# Swap panes interactively via choose-tree
# S: Swap selected pane with current pane
bind-key S choose-tree "swap-pane -s '%%'"

# -----------------------------------------------------------------------------
# TPM Initialization
# -----------------------------------------------------------------------------
run '~/.tmux/plugins/tpm/tpm'
