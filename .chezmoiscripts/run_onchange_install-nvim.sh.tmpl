#!/bin/bash
set -e

INSTALL_DIR="$HOME/.local"
BIN_DIR="$INSTALL_DIR/bin"
NVIM_DIR="$INSTALL_DIR/nvim"

mkdir -p "$BIN_DIR"

# Detect architecture
case "$(uname -m)" in
    x86_64)  ARCH="x86_64" ;;
    aarch64) ARCH="arm64" ;;
    *)       echo "Unsupported architecture: $(uname -m)"; exit 1 ;;
esac

TARBALL="nvim-linux-${ARCH}.tar.gz"
URL="https://github.com/neovim/neovim/releases/latest/download/${TARBALL}"

echo "Downloading latest Neovim tarball ($ARCH)..."
curl -L "$URL" | tar xz -C /tmp

rm -rf "$NVIM_DIR"
mv "/tmp/nvim-linux-${ARCH}" "$NVIM_DIR"

ln -sf "$NVIM_DIR/bin/nvim" "$BIN_DIR/nvim"

echo "Neovim installed: $("$BIN_DIR/nvim" --version | head -1)"
