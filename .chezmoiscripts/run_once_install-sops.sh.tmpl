#!/bin/sh
set -e

VERSION="3.13.1"

echo "Installing sops (secret manager)..."

# Create bin directory if needed
if [ ! -d ~/.local/bin ]; then
    mkdir -p ~/.local/bin
fi

# Select the correct asset name based on OS and architecture
{{ if eq .chezmoi.os "darwin" -}}
ASSET="sops-v${VERSION}.darwin.{{ .chezmoi.arch }}"
{{ else if eq .chezmoi.os "linux" -}}
ASSET="sops-v${VERSION}.linux.{{ .chezmoi.arch }}"
{{ else if eq .chezmoi.os "windows" -}}
ASSET="sops-v${VERSION}.windows.{{ .chezmoi.arch }}.exe"
{{ else -}}
echo "ERROR: unsupported OS: {{ .chezmoi.os }}"
exit 1
{{ end }}

# Download sops binary
echo "  Downloading: ${ASSET}"
curl -fsSL "https://github.com/getsops/sops/releases/download/v${VERSION}/${ASSET}" \
    -o /tmp/sops

# Make executable and install
chmod +x /tmp/sops
install /tmp/sops ~/.local/bin/sops

echo "sops installed successfully (v${VERSION})"
