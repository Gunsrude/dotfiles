#!/bin/sh
# run_onchange_install-nvm-node.sh
# chezmoi:template: hash={{ include "dot_config/nvim/lua/plugins/lsp.lua" | sha256sum }}

set -eu

# Both nvm and its installer require bash
if ! command -v bash >/dev/null 2>&1; then
    echo "Skipping nvm install: bash not found. Please install bash and re-run chezmoi apply." >&2
    exit 0
fi

NVM_VERSION="v0.40.1"
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
export PROFILE=/dev/null
MIN_NODE_VERSION=18

# Install nvm if not present
if [ ! -d "$NVM_DIR" ]; then
    echo "Installing nvm $NVM_VERSION..."
    curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh" | bash
else
    echo "nvm already installed at $NVM_DIR"
fi

# Source nvm for this script
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Check if we need to install/upgrade node
NEED_INSTALL=false

if ! nvm which default >/dev/null 2>&1; then
    NEED_INSTALL=true
    echo "No default node set"
else
    CURRENT=$(nvm version default 2>/dev/null | sed 's/v//')
    MAJOR=$(echo "$CURRENT" | cut -d. -f1)
    if [ "$MAJOR" -lt "$MIN_NODE_VERSION" ]; then
        NEED_INSTALL=true
        echo "Node v$CURRENT is below v${MIN_NODE_VERSION}, upgrading"
    else
        echo "Node v$CURRENT meets minimum v${MIN_NODE_VERSION}"
    fi
fi

if [ "$NEED_INSTALL" = "true" ]; then
    nvm install --lts
    nvm alias default 'lts/*'
fi

echo "Done. node: $(node --version), npm: $(npm --version)"
