#!/usr/bin/env bash
set -euo pipefail

PINNED_VERSION="v1.33.1"
export GOOSE_VERSION="$PINNED_VERSION"
export CONFIGURE=false
export GOOSE_DISABLE_KEYRING=1

install_goose() {
    curl -fsSL https://github.com/block/goose/releases/download/stable/download_cli.sh \
    | bash
}

if ! command -v goose >/dev/null 2>&1; then
  install_goose
else
  CURRENT=$(goose --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  WANTED=$(echo "$PINNED_VERSION" | sed 's/^v//')
  if [ "$CURRENT" != "$WANTED" ]; then
    echo "goose $CURRENT installed, updating to $PINNED_VERSION..."
    install_goose
  else
    echo "goose $CURRENT already at pinned version, skipping."
  fi
fi

