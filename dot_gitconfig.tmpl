[user]
	name = {{ .name | quote }}
	email = {{ .email | quote }}
[pull]
    rebase = true
[merge]
	tool = vimdiff
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[core]
	editor = nvim
	excludesFile = ~/.config/git/ignore

