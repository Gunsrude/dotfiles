{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  "enabled": true,
  "cache_ttl": "30m",
  "execute_threshold_percentage": {
    "default": 80,
    "Stellar/full": 80,
    "Stellar/coder": 80,
    "Stellar/research": 80,
    "Stellar/dirtycode": 80,
    "openrouter/minimax": 80
  },
  "protected_tags": 20,
  "clear_reasoning_age": 30,
  "historian": {
    "model": "openrouter/mistral",
    "fallback_models": ["openrouter/deepseek-explorer"],
    "temperature": 0.3,
    "two_pass": true
  },
  "historian_timeout_ms": 600000,
  "history_budget_percentage": 0.15,
  "commit_cluster_trigger": {
    "enabled": true,
    "min_clusters": 3
  },
  "temporal_awareness": true,
  "caveman_text_compression": {
    "enabled": true
  },
  "memory": {
    "enabled": true,
    "injection_budget_tokens": 4000,
    "auto_promote": true,
    "retrieval_count_promotion_threshold": 3,
    "auto_search": {
      "enabled": true,
      "score_threshold": 0.55,
      "min_prompt_chars": 20
    },
    "git_commit_indexing": {
      "enabled": true,
      "since_days": 365,
      "max_commits": 2000
    }
  },
  "embedding": {
    "provider": "openai-compatible",
    "model": "embed",
    "endpoint": "http://llm.stellar.build:8080/v1",
    "api_key": "none"
  },
  "sidekick": {
    "model": "openrouter/mistral",
    "fallback_models": ["openrouter/deepseek-explorer"],
    "temperature": 0.2,
    "timeout_ms": 30000
  },
  "dreamer": {
    "model": "Stellar/coder",
    "fallback_models": ["openrouter/deepseek-explorer"],
    "temperature": 0.3,
    "disable": false,
    "tasks": {
      "map-memories": { "schedule": "0 2 * * *" },
      "verify": { "schedule": "0 3 * * *" },
      "verify-broad": { "schedule": "0 4 * * 0" },
      "curate": { "schedule": "0 4 * * 0" },
      "classify-memories": { "schedule": "0 6 * * *" },
      "retrospective": { "schedule": "0 5 * * *" },
      "maintain-docs": { "schedule": "" },
      "review-user-memories": { "schedule": "0 3 * * *", "promotion_threshold": 3 }
    }
  }
}
