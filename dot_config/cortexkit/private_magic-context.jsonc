{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  "enabled": true,
  "cache_ttl": "30m",
  "execute_threshold_tokens": {
    "default": 1000000,
    "Stellar/full": 80000,
    "Stellar/coder": 80000,
    "Stellar/research": 80000,
    "Stellar/dirtycode": 131072,
    "openrouter/mistral": 80000
  },
  "protected_tags": 20,
  "clear_reasoning_age": 30,
  "historian": {
    "model": "openrouter/mistral",
    "fallback_models": [],
    "temperature": 0.3,
    "two_pass": true
  },
  "historian_timeout_ms": 600000,
  "history_budget_percentage": 0.15,
  "commit_cluster_trigger": {
    "enabled": true,
    "min_clusters": 3
  },
  "compressor": {
    "enabled": true,
    "grace_compartments": 10
  },
  "temporal_awareness": true,
  "caveman_text_compression": {
    "enabled": true
  },
  "memory": {
    "enabled": true,
    "injection_budget_tokens": 4000,
    "auto_promote": true,
    "retrieval_count_promotion_threshold": 3,
    "auto_search": {
      "enabled": true,
      "score_threshold": 0.55,
      "min_prompt_chars": 20
    },
    "git_commit_indexing": {
      "enabled": true,
      "since_days": 365,
      "max_commits": 2000
    }
  },
  "embedding": {
    "provider": "openai-compatible",
    "model": "embed",
    "endpoint": "http://llm.stellar.build:8080/v1",
    "api_key": "none"
  },
  "sidekick": {
    "model": "openrouter/mistral",
    "temperature": 0.2,
    "timeout_ms": 30000
  },
  "dreamer": {
    "model": "Stellar/coder",
    "temperature": 0.3,
    "schedule": "0 2 * * *",
    "max_runtime_minutes": 120,
    "task_timeout_minutes": 20,
    "tasks": {
      "consolidate": {"enabled": true},
      "verify": {"enabled": true},
      "archive-stale": {"enabled": true},
      "improve": {"enabled": true}
    }
  }
}
