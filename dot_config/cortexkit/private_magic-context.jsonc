{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  "enabled": true,
  "cache_ttl": "30m",
  "execute_threshold_percentage": 80,
  "protected_tags": 20,
  "nudge_interval_tokens": 10000,
  "auto_drop_tool_age": 30,
  "drop_tool_structure": true,
  "clear_reasoning_age": 30,
  "iteration_nudge_threshold": 15,
  "system_message_merge": true,
  "historian": {
    "model": "opencode/deepseek-v4-flash",
    "fallback_models": [
      "opencode/kimi-k2.5"
    ],
    "temperature": 0.3,
    "two_pass": true
  },
  "historian_timeout_ms": 600000,
  "history_budget_percentage": 0.15,
  "commit_cluster_trigger": {
    "enabled": true,
    "min_clusters": 3
  },
  "compressor": {
    "enabled": true,
    "grace_compartments": 10
  },
  "temporal_awareness": true,
  "caveman_text_compression": {
    "enabled": true
  },
  "memory": {
    "enabled": true,
    "injection_budget_tokens": 4000,
    "auto_promote": true,
    "retrieval_count_promotion_threshold": 3,
    "auto_search": {
      "enabled": true,
      "score_threshold": 0.55,
      "min_prompt_chars": 20
    },
    "git_commit_indexing": {
      "enabled": true,
      "since_days": 365,
      "max_commits": 2000
    }
  },
  "embedding": {
    "provider": "openai-compatible",
    "model": "embed",
    "endpoint": "http://llm.stellar.build:8080/v1",
    "api_key": "none"
  },
  "sidekick": {
    "model": "opencode/deepseek-v4-flash",
    "temperature": 0.2,
    "timeout_ms": 30000
  },
  "dreamer": {
    "model": "Stellar/coder",
    "temperature": 0.3,
    "schedule": "02:00-06:00",
    "max_runtime_minutes": 120,
    "task_timeout_minutes": 20,
    "tasks": [
      "consolidate",
      "verify",
      "archive-stale",
      "improve"
    ],
    "inject_docs": true,
    "pin_key_files": {
      "enabled": false,
      "token_budget": 10000,
      "min_reads": 4
    }
  },
 }
