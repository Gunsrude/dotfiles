{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "catppuccin",
  "keybinds": {
    "session_rename": "<leader>R",
    "session_interrupt": "<leader>i"
  },
  "plugin": [
    "@cortexkit/opencode-magic-context@0.17.2",
    ["@renjfk/opencode-voice", {
      "endpoint": "http://llm.stellar.build:8080/v1",
      "model": "qwen3-small",
      "apiKeyEnv": "OLLAMA_API_KEY",
      "maxTokens": 2048,
      "sttPrompt": "~/.config/opencode/stt-prompt.md"
    }]
  ]
}
