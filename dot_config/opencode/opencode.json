{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "qwen3.6": {
          "name": "Qwen3 35B MoE"
        },
        "qwen-small": {
          "name": "Qwen Small + Vision"
        }
      }
    },
    "opencode": {
      "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "model": "llamacpp/qwen3.6",
  "small_model": "llamacpp/qwen-small",
  "tools": {
    "websearch": false,
    "kagi_kagi_summarizer": false
  },
  "compaction": {
      "prune": false
  },
  "permission": {
    "bash": {
      "git *": "ask",
      "git diff*": "allow",
      "git fetch*": "allow",
      "git status*": "allow",
      "git log*": "allow"
    }
  },
  "instructions": [
      "~/.config/opencode/PROFILE.md"
  ],
  "plugin": [
    "@cortexkit/opencode-magic-context",
    "envsitter-guard@latest",
    "opencode-shell-strategy@latest",
    ["opencode-image-vision", {
      "vision": {
        "provider": "custom",
        "model": "qwen-small",
        "apiKey": "local",
        "baseUrl": "http://llm.stellar.build:8080/v1",
        "language": "en"
      },
      "clipboard": {
        "enabled": true
      }
    }]
  ]
}
