{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "Stellar": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "full": {
          "name": "Brain Gooder",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "coder": {
          "name": "Coding Bitch",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "research": {
          "name": "Researcher",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "dirtycode": {
            "name": "Dirty Coder",
            "limit": {
                "context": 131072,
                "output": 16384
            }
        }
      }
    },
    "opencode": {
      "apiKey": "{env:OPENCODE_ZEN_API_KEY}",
      "models": {
        "qwen3.7-max": {
          "name": "Q",
          "limit": { "context": 65536, "output": 16384 }
        },
        "big-pickle": {
          "name": "Big Pickle",
          "limit": { "context": 131072, "output": 16384 }
        },
        "deepseek-v4-flash": {
          "name": "Red Scare",
          "limit": { "context": 800000, "output": 131072 }
        },
        "deepseek-v4-flash-limited": {
          "id": "deepseek-v4-flash",
          "name": "Red Scare (limited)",
          "limit": { "context": 80000, "output": 8192 }
        }
      }
    }
  },
  "default_agent": "team-lead",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "mcp": {
    "brave": {
      "type": "local",
      "command": ["npx", "-y", "@brave/brave-search-mcp-server"],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "enabled": true
    }
  },
  "model": "Stellar/full",
  "small_model": "opencode/deepseek-v4-flash",
  "tools": {
    "websearch": false,
    "webfetch": false,
    "git_*": false
  },
  "lsp": true,
  "compaction": {
    "prune": false,
    "auto": false
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    },
    "bash": {
      "git *": "deny",
    },
    "exa_*": "deny",
    "brave_*": "deny",
    "kagi_*": "deny",
    "git_*": "deny"
  },
  "instructions": [
    "~/.config/opencode/PROFILE.md"
  ],
  "plugin": [
    "@cortexkit/opencode-magic-context@latest"
  ]
}
