{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "Stellar": {
      "name": "Stellar",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://llm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "full": {
          "name": "Brain Gooder",
          "limit": { "context": 100000, "output": 16384 },
          "variants": [
            { "id": "none",   "settings": { "reasoningEffort": "none" } },
            { "id": "low",    "settings": { "reasoningEffort": "low" },    "body": { "reasoning_budget_tokens": 2048 } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" }, "body": { "reasoning_budget_tokens": 4096 } },
            { "id": "high",   "settings": { "reasoningEffort": "high" },   "body": { "reasoning_budget_tokens": 8192 } },
            { "id": "xhigh",  "settings": { "reasoningEffort": "xhigh" },  "body": { "reasoning_budget_tokens": 8192 } },
            { "id": "temp03", "body": { "temperature": 0.3 } },
            { "id": "router", "settings": { "reasoningEffort": "medium", "temperature": 0.3 }, "body": { "reasoning_budget_tokens": 4096 } }
          ]
        },
        "coder": {
          "name": "Coding Bitch",
          "capabilities": { "reasoning": { "supported": true } },
          "settings": { "reasoningEffort": "medium" },
          "variants": [
            { "id": "coder", "settings": { "reasoningEffort": "medium", "temperature": 0.2 } },
            { "id": "runner", "settings": { "reasoningEffort": "medium", "temperature": 0.2 } },
            { "id": "architect", "settings": { "reasoningEffort": "medium", "temperature": 0.4 } },
            { "id": "qa", "settings": { "reasoningEffort": "medium", "temperature": 0.1 } }
          ],
          "limit": { "context": 131072, "output": 16384 }
        },
        "dirtycode": {
          "name": "Dirty Coder",
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    },
    "openrouter": {
      "env": ["OPENROUTER_API_KEY"],
      "models": {
        "qwen-mem": {
          "modelID": "qwen/qwen3-next-80b-a3b-instruct",
          "name": "Memory Keeper"
        },
        "glm5-high": {
          "modelID": "z-ai/glm-5.3-flash",
          "name": "ChatBot",
          "settings": { "reasoningEffort": "xhigh" },
          "variants": [
            { "id": "talker", "body": { "temperature": 0.8 } }
          ],
          "limit": { "context": 100000, "output": 16384 }
        },
        "glm5-low": {
          "modelID": "z-ai/glm-5.3-flash",
          "name": "GLM Low",
          "settings": { "reasoningEffort": "low" },
          "variants": [
            { "id": "gitops", "body": { "temperature": 0.1 } },
            { "id": "fileexplorer", "body": { "temperature": 0.2 } },
            { "id": "quickresearch", "body": { "temperature": 0.7 } }
          ]
        },
        "glm5.3-max": {
          "modelID": "z-ai/glm-5.3",
          "name": "QA",
          "settings": { "reasoningEffort": "max" },
          "limit": { "context": 262144, "output": 16384 }
        }
      }
    }
  },
  "default_agent": "router",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "agents": {
    "title": { "model": "openrouter/glm5-low" },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  },
  "mcp": {
    "servers": {
      "brave": {
        "type": "local",
        "command": ["npx", "-y", "@brave/brave-search-mcp-server", "--enabled-tools", "brave_web_search", "brave_llm_context"],
        "environment": {
          "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
        },
        "disabled": false
      }
    }
  },
  "model": "Stellar/full",
  "experimental": { "subagent_depth": 2 },
  "compaction": {
    "auto": false
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "/tmp/**", "effect": "allow" },
    { "action": "shell", "resource": "git *", "effect": "deny" },
    { "action": "exa_*", "resource": "*", "effect": "deny" },
    { "action": "brave_*", "resource": "*", "effect": "deny" },
    { "action": "kagi_*", "resource": "*", "effect": "deny" },
    { "action": "git_*", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" }
  ],
  "instructions": [
    "~/.config/opencode/PROFILE.md"
  ],
  "plugins": ["@cortexkit/opencode-magic-context@0.49.31"]
}

