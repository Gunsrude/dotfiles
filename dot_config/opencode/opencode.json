{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "Stellar": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "full": {
          "name": "Brain Gooder",
          "limit": {
            "context": 100000,
            "output": 16384
          }
        },

        "coder": {
          "id": "coder",
          "name": "Coding Bitch",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },

        "dirtycode": {
            "name": "Dirty Coder",
            "limit": {
                "context": 131072,
                "output": 16384
            }
        }
      }
    },
    "openrouter": {
      "apiKey": "{env:OPENROUTER_API_KEY}",
      "models": {

        "qwen-mem": {
          "id": "qwen/qwen3-next-80b-a3b-instruct",
          "name": "Memory Keeper"
        },
        "glm5-high": {
          "id": "z-ai/glm-5.3-flash",
          "name": "ChatBot",
          "reasoning": true,
          "options": {
            "reasoning": { "effort": "xhigh" }
          },
          "limit": { "context": 100000, "output": 16384 }
        },
        "glm5-low": {
          "id": "z-ai/glm-5.3-flash",
          "name": "GLM Low",
          "reasoning": true,
          "options": {
            "reasoning": { "effort": "low" }
          }
        },
        "glm5.3-max": {
          "id": "z-ai/glm-5.3",
          "name": "QA",
          "reasoning": true,
          "options": {
            "reasoning": { "effort": "max" }
          },
          "limit": { "context": 262144, "output": 16384 }
        }
      }
    }
  },
  "default_agent": "router",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  },
  "mcp": {
    "brave": {
      "type": "local",
      "command": ["npx", "-y", "@brave/brave-search-mcp-server", "--enabled-tools", "brave_web_search", "brave_llm_context"],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "enabled": true
    }
  },
  "subagent_depth": 2,
  "model": "Stellar/full",
  "small_model": "openrouter/glm5-low",
  "tools": {
    "websearch": false,
    "webfetch": false,
    "git_*": false
  },
  "lsp": true,
  "compaction": {
    "prune": false,
    "auto": false
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    },
    "bash": {
      "git *": "deny"
    },
    "exa_*": "deny",
    "brave_*": "deny",
    "kagi_*": "deny",
    "git_*": "deny"
  },
  "instructions": [
    "~/.config/opencode/PROFILE.md"
  ],
  "plugin": [
    "@cortexkit/opencode-magic-context@0.40.1"
  ]
}

