{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "RatOnAStick": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://dumblm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "small": {
          "name": "Stellar The Not So Bright",
          "supportsToolCalls": true,
          "limit": {
            "context": 32768,
            "output": 16384
          }
        }
      }
    },
    "Styx": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "full": {
          "name": "Stellar Brain Gooder",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "coder": {
            "name": "Stellar Coding Bitch",
            "limit": {
                "context": 65536,
                "output": 16384
            }
        },
        "small": {
          "name": "Stellar In Bed",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "opencode": {
      "apiKey": "{env:OPENCODE_ZEN_API_KEY}",
      "models": {
        "gpt-5-nano": {
          "name": "Zen Nano",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "qwen3.5-plus": {
          "name": "Zen Qwen Small",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "big-pickle": {
          "name": "Big Pickle",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "agent": {
    "dreamer": { "mode": "subagent", "hidden": false },
    "sidekick": { "mode": "subagent", "hidden": false }
  },
  "mcp": {
    "exa": {
      "type": "local",
      "command": ["npx", "-y", "exa-mcp-server"],
      "environment": {
        "EXA_API_KEY": "{env:EXA_API_KEY}"
      },
      "enabled": true
    }
  },
  "model": "Styx/full",
  "small_model": "RatOnAStick/small",
  "tools": {
    "websearch": false
  },
  "lsp": true,
  "compaction": {
      "prune": false,
      "auto": false
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    },
    "bash": {
      "git *": "ask",
      "git diff*": "allow",
      "git fetch*": "allow",
      "git status*": "allow",
      "git log*": "allow"
    }
  },
  "instructions": [
      "~/.config/opencode/PROFILE.md",
      "~/.config/opencode/plugin/shell-strategy/shell_strategy.md"
  ],

  "plugin": [
    "envsitter-guard@latest",
    "@tarquinen/opencode-dcp@latest",
    ["@vectorize-io/opencode-hindsight", {
      "hindsightApiUrl": "http://dumblm.stellar.build:8888",
      "autoRecall": true,
      "autoRetain": true,
      "recallBudget": "mid",
      "retainEveryNTurns": 3,
      "bankMission": "Coding assistant for active development projects. Focus on architecture decisions, library quirks, API patterns, naming conventions, bugs found, and decisions made. Ignore conversational filler."
    }]
  ]
}

