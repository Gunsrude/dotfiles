{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "qwen-full": {
          "name": "Qwen3 35B MoE",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "qwen-small": {
          "name": "Qwen Small + Vision",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    },
    "opencode": {
      "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "agent": {
    "historian": { "mode": "subagent", "hidden": false },
    "historian-editor": { "mode": "subagent", "hidden": false },
    "dreamer": { "mode": "subagent", "hidden": false },
    "sidekick": { "mode": "subagent", "hidden": false }
  },
  "mcp": {
    "kagi": {
      "type": "local",
      "command": ["npx", "-y", "github:czottmann/kagi-ken-mcp"],
      "environment": {
        "KAGI_SESSION_TOKEN": "{env:KAGI_SESSION_TOKEN}"
      }
    },
    "exa": {
      "type": "local",
      "command": ["npx", "-y", "exa-mcp-server"],
      "environment": {
        "EXA_API_KEY": "{env:EXA_API_KEY}"
      }
    }
  },
  "model": "llamacpp/qwen-full",
  "small_model": "llamacpp/qwen-small",
  "tools": {
    "websearch": false,
    "kagi_kagi_summarizer": false
  },
  "lsp": true,
  "compaction": {
      "prune": false,
      "auto": false
  },
  "permission": {
    "bash": {
      "git *": "ask",
      "git diff*": "allow",
      "git fetch*": "allow",
      "git status*": "allow",
      "git log*": "allow"
    }
  },
  "instructions": [
      "~/.config/opencode/PROFILE.md"
  ],
  "plugin": [
    "@cortexkit/opencode-magic-context@0.17.2",
    "envsitter-guard@latest",
    "opencode-shell-strategy@latest",
    ["opencode-image-vision", {
      "vision": {
        "provider": "custom",
        "model": "qwen-small",
        "apiKey": "local",
        "baseUrl": "http://llm.stellar.build:8080/v1",
        "language": "en"
      },
      "clipboard": {
        "enabled": true
      }
    }]
  ]
}

