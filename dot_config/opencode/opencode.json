{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "qwen3.6": {
          "name": "Qwen3 35B MoE"
        },
        "qwen3-small": {
          "name": "Qwen3 1.7B (small)"
        }
      }
    },
    "opencode": {
      "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "model": "llamacpp/qwen3.6",
  "small_model": "llamacpp/qwen3-small",
  "tools": {
    "websearch": true
  },
  "compaction": {
      "prune": false
  },
  "permission": {
    "bash": {
      "git *": "ask",
      "git diff*": "allow",
      "git fetch*": "allow",
      "git status*": "allow",
      "git log*": "allow"
    }
  },
  "instructions": [
      "~/.config/opencode/PROFILE.md"
  ],
  "plugin": [
    ["opencode-model-stats", { "prefillPollMs": 0 }],
    "@tarquinen/opencode-dcp@latest",
    "opencode-memory-plugin@latest",
    "envsitter-guard@latest",
    "opencode-shell-strategy@latest"
  ]
}
