{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "Stellar": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "full": {
          "name": "Brain Gooder",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "coder": {
          "name": "Coding Bitch",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "research": {
          "name": "Researcher",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    },
    "StellarVision": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://dumblm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "vision": {
          "name": "Yandere Eyes",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    },
    "opencode": {
      "apiKey": "{env:OPENCODE_ZEN_API_KEY}",
      "models": {
        "gpt-5-nano": {
          "name": "Zen Nano",
          "limit": { "context": 32768, "output": 4096 }
        },
        "qwen3.5-plus": {
          "name": "Zen Qwen Small",
          "limit": { "context": 32768, "output": 4096 }
        },
        "big-pickle": {
          "name": "Big Pickle",
          "limit": { "context": 131072, "output": 16384 }
        },
        "gpt-5-codex": {
          "name": "GPT-5 Codex",
          "limit": { "context": 400000, "output": 131072 }
        },
        "gpt-5.1-codex-max": {
          "name": "Codex Max",
          "limit": { "context": 400000, "output": 131072 }
        },
        "gpt-5.1-codex-mini": {
          "name": "Codex Mini",
          "limit": { "context": 400000, "output": 131072 }
        },
        "kimi-k2.5": {
          "name": "Kimi K2.5",
          "limit": { "context": 262144, "output": 65536 }
        }
      }
    }
  },
  "default_agent": "team-lead",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "mcp": {
    "brave": {
      "type": "local",
      "command": ["npx", "-y", "@brave/brave-search-mcp-server"],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": ["npx", "-y", "@cyanheads/git-mcp-server@latest"],
      "environment": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_LOG_LEVEL": "info",
        "MCP_RESPONSE_VERBOSITY": "minimal"
      },
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
      "headers": {
        "x-api-key": "{env:EXA_API_KEY}"
      },
      "enabled": false
    },
    "kagi": {
      "type": "remote",
      "url": "https://mcp.kagi.com/mcp",
      "headers": {
        "x-api-key": "{env:KAGI_API_KEY}"
      },
      "enabled": false
    }
  },
  "model": "Stellar/full",
  "small_model": "opencode/big-pickle",
  "tools": {
    "websearch": false
  },
  "lsp": true,
  "compaction": {
    "prune": false,
    "auto": false
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    },
    "bash": {
      "git *": "deny",
    },
    "exa_*": "deny",
    "brave_*": "deny",
    "kagi_*": "deny",
    "git_*": "deny"
  },
  "instructions": [
    "~/.config/opencode/PROFILE.md"
  ],
  "plugin": [
    "@cortexkit/opencode-magic-context@latest"
  ]
}
