{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "qwen3.6": {
          "name": "qwen3.6",
          "contextLength": 131072
        }
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "model": "llamacpp/qwen3.6",
  "tools": {
    "websearch": true
  },
  "permission": {
    "bash": {
      "git *": "ask",
      "snip git *": "ask",
      "git diff*": "allow",
      "git fetch*": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "snip git diff*": "allow",
      "snip git fetch*": "allow",
      "snip git status*": "allow",
      "snip git log*": "allow"
    }
  },
  "instructions": ["~/.config/opencode/PROFILE.md"],
  "plugin": [
    "opencode-mem"
  ]
}
