{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "Stellar": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "full": {
          "name": "Brain Gooder",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "coder": {
          "name": "Coding Bitch",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "research": {
          "name": "Researcher",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "dirtycode": {
            "name": "Dirty Coder",
            "limit": {
                "context": 131072,
                "output": 16384
            }
        }
      }
    },
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
      },
      "models": {
        "qwen3.7-max": {
          "name": "Brainier",
          "limit": { "context": 1000000, "output": 32768 }
        },
        "qwen3.7-plus": {
          "id": "qwen3.7-plus",
          "name": "Eyes",
          "limit": { "context": 1000000, "output": 16384 }
        },
        "gemini-3.5-flash-lite": {
          "name": "Don't be Evil",
          "reasoning": false,
          "limit": { "context": 40000, "output": 8192}
        }
      }
    },
    "openrouter": {
      "apiKey": "{env:OPENROUTER_API_KEY}",
      "models": {
        "qwen3.7-plus": {
            "id": "qwen/qwen3.7-plus",
            "name": "Commitment Issues"
        },
        "deepseek": {
          "id": "deepseek/deepseek-v4-flash",
          "name": "Nosy Bitch",
          "options": {
            "provider": {
              "order": ["deepinfra", "venice"],
              "allow_fallbacks": false
            }
          }
        },
        "kimi2.7": {
          "id": "moonshotai/kimi-k2.7-code",
          "name": "Chatty Bitch",
          "limit": { "context": 80000, "output": 16384 },
          "options": {
            "provider": {
              "order": ["coreweave", "inceptron", "deepinfra"],
              "allow_fallbacks": false
            }
          }
        },
        "mistral": {
          "id": "mistralai/mistral-small-3.2-24b-instruct",
          "name": "Backup Bitch",
          "limit": { "context": 80000, "output": 16384 },
          "options": {
            "provider": {
              "order": ["mistral", "deepinfra"],
              "allow_fallbacks": true
            }
          }
        }
      }
    }
  },
  "default_agent": "mouth",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  },
  "mcp": {
    "brave": {
      "type": "local",
      "command": ["npx", "-y", "@brave/brave-search-mcp-server"],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "enabled": true
    }
  },
  "subagent_depth": 2,
  "model": "openrouter/deepseek",
  "small_model": "openrouter/deepseek",
  "tools": {
    "websearch": false,
    "webfetch": false,
    "git_*": false
  },
  "lsp": true,
  "compaction": {
    "prune": false,
    "auto": false
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    },
    "bash": {
      "git *": "deny"
    },
    "exa_*": "deny",
    "brave_*": "deny",
    "kagi_*": "deny",
    "git_*": "deny"
  },
  "instructions": [
    "~/.config/opencode/PROFILE.md"
  ],
  "plugin": [
    "@cortexkit/opencode-magic-context@latest"
  ]
}
