{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "RatOnAStick": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://dumblm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "small": {
          "name": "Stellar The Not So Bright",
          "supportsToolCalls": false,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "explorer": {
          "name": "No Man's Sky",
          "supportsToolCalls": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "Styx": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "full": {
          "name": "Stellar Brain Gooder",
          "limit": {
            "context": 98304,
            "output": 16384
          }
        },
        "coder": {
          "name": "Stellar Coding Bitch",
          "limit": {
            "context": 65536,
            "output": 16384
          }
        }
      }
    },
    "opencode": {
      "apiKey": "{env:OPENCODE_ZEN_API_KEY}",
      "models": {
        "gpt-5-nano": {
          "name": "Zen Nano",
          "limit": { "context": 32768, "output": 4096 }
        },
        "qwen3.5-plus": {
          "name": "Zen Qwen Small",
          "limit": { "context": 32768, "output": 4096 }
        },
        "big-pickle": {
          "name": "Big Pickle",
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    }
  },
  "default_agent": "orchestrator",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "mcp": {
    "exa": {
      "type": "local",
      "command": ["npx", "-y", "exa-mcp-server"],
      "environment": {
        "EXA_API_KEY": "{env:EXA_API_KEY}"
      },
      "enabled": true
    }
  },
  "model": "Styx/full",
  "small_model": "RatOnAStick/small",
  "tools": {
    "websearch": false
  },
  "lsp": true,
  "compaction": {
    "prune": false,
    "auto": false
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    },
    "bash": {
      "git *": "ask",
      "git diff*": "allow",
      "git fetch*": "allow",
      "git status*": "allow",
      "git log*": "allow"
    }
  },
  "instructions": [
    "~/.config/opencode/PROFILE.md"
  ],
  "plugin": [
    "envsitter-guard@latest",
    "opencode-mem@latest",
    "@cortexkit/opencode-magic-context@latest"
  ]
}

