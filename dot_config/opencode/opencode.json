{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "Stellar": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "full": {
          "name": "Brain Gooder",
          "limit": {
            "context": 80000,
            "output": 16384
          }
        },
        "talker": {
          "id": "coder",
          "name": "Wordsmith",
          "limit": {
            "context": 100000,
            "output": 16384
          }
        },
        "brainer": {
          "id": "coder",
          "name": "I brain for you",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "spine": {
          "id": "coder",
          "name": "Slipped Disk",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "coder": {
          "id": "coder",
          "name": "Coding Bitch",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "butterfingers": {
          "id": "coder",
          "name": "Butter Fingers",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "dirtycode": {
            "name": "Dirty Coder",
            "limit": {
                "context": 131072,
                "output": 16384
            }
        }
      }
    },
    "openrouter": {
      "apiKey": "{env:OPENROUTER_API_KEY}",
      "models": {
        "deepseek-git": {
          "id": "deepseek/deepseek-v4-flash-0731",
          "name": "Commitment Issues"
        },
        "deepseek-research": {
          "id": "deepseek/deepseek-v4-flash-0731",
          "name": "Nosy Bitch"
        },
        "deepseek-explorer": {
          "id": "deepseek/deepseek-v4-flash-0731",
          "name": "Thicc"
        },
        "deepseek-talker": {
          "id": "deepseek/deepseek-v4-flash-0731",
          "name": "From China with Love",
          "limit": { "context": 60000, "output": 16384 }
        },
        "kimi2.7": {
          "id": "moonshotai/kimi-k2.7-code",
          "name": "Chatty Bitch",
          "limit": { "context": 60000, "output": 16384 }
        },
        "kimi3": {
          "id": "moonshotai/kimi-k3",
          "name": "Coffee Power"
        },
        "mistral": {
          "id": "mistralai/mistral-small-3.2-24b-instruct",
          "name": "Backup Bitch",
          "limit": { "context": 60000, "output": 16384 }
        },
        "qwen-main": {
          "id": "qwen/qwen3.6-27b",
          "name": "What a tool",
          "limit": { "context": 60000, "output": 16384 }
        },
        "qwen-mem": {
          "id": "qwen/qwen3-next-80b-a3b-instruct",
          "name": "Memory Keeper"
        }
      }
    }
  },
  "default_agent": "router",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  },
  "mcp": {
    "brave": {
      "type": "local",
      "command": ["npx", "-y", "@brave/brave-search-mcp-server"],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      },
      "enabled": true
    }
  },
  "subagent_depth": 2,
  "model": "Stellar/full",
  "small_model": "openrouter/deepseek-explorer",
  "tools": {
    "websearch": false,
    "webfetch": false,
    "git_*": false
  },
  "lsp": true,
  "compaction": {
    "prune": false,
    "auto": false
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    },
    "bash": {
      "git *": "deny"
    },
    "exa_*": "deny",
    "brave_*": "deny",
    "kagi_*": "deny",
    "git_*": "deny"
  },
  "instructions": [
    "~/.config/opencode/PROFILE.md"
  ],
  "plugin": [
    "@cortexkit/opencode-magic-context@0.33.6"
  ]
}

