{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.stellar.build:8080/v1",
        "includeUsage": true
      },
      "models": {
        "full": {
          "name": "Stellar Coding",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "historian": {
            "name": "Stellar Historian",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "small": {
          "name": "Stellar Small",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    },
    "opencode": {
      "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "agent": {
    "historian": { "mode": "subagent", "hidden": false },
    "historian-editor": { "mode": "subagent", "hidden": false },
    "dreamer": { "mode": "subagent", "hidden": false },
    "sidekick": { "mode": "subagent", "hidden": false }
  },
  "mcp": {
    "kagi": {
      "type": "local",
      "command": ["npx", "-y", "github:czottmann/kagi-ken-mcp"],
      "environment": {
        "KAGI_SESSION_TOKEN": "{env:KAGI_SESSION_TOKEN}"
      }
    },
    "exa": {
      "type": "local",
      "command": ["npx", "-y", "exa-mcp-server"],
      "environment": {
        "EXA_API_KEY": "{env:EXA_API_KEY}"
      },
      "enabled": false
    }
  },
  "model": "llamacpp/full",
  "small_model": "llamacpp/small",
  "tools": {
    "websearch": false
  },
  "lsp": true,
  "compaction": {
      "prune": false,
      "auto": false
  },
  "permission": {
    "bash": {
      "git *": "ask",
      "git diff*": "allow",
      "git fetch*": "allow",
      "git status*": "allow",
      "git log*": "allow"
    },
    "skill": {
      "restart-service": "ask"
    }
  },
  "instructions": [
      "~/.config/opencode/PROFILE.md",
      "~/.config/opencode/plugin/shell-strategy/shell_strategy.md"
  ],
  "plugin": [
    "@cortexkit/opencode-magic-context@0.18.0",
    "envsitter-guard@latest"
    }]
  ]
}

