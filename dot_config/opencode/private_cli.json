{
  "$schema": "https://opencode.ai/cli.json",
  "theme": { "name": "catppuccin", "mode": "dark" },
  "keybinds": {
    "app.exit": "<leader>q",
    "prompt.clear": "none",
    "session.rename": "<leader>R"
  },
  "session": {
    "thinking": "show",
    "verbosity": "high"
  },
  "tabs": {
    "mode": "off",
    "indicators": "status"
  },
  "terminal": {
    "title": true
  },
  "prompt": {
    "image_preview": true
  }
}
