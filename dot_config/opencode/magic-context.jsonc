{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  "enabled": true,

  // ── Core behaviour ──────────────────────────────────────────────────────

  // Wait 5 min after a response before applying queued ops (cache safety)
  "cache_ttl": "5m",

  "execute_threshold_tokens": {
    "default": 100000
  },

  // Last 20 tags (messages/tool calls) are immune from immediate dropping
  "protected_tags": 20,

  // Minimum token growth between rolling nudges to the agent
  "nudge_interval_tokens": 10000,

  // Auto-drop tool outputs older than 100 tags
  "auto_drop_tool_age": 100,

  // true = dropped tool parts fully removed (saves more tokens)
  // false = keeps tool name + "[truncated]" (~4K extra per 60 tools, but
  //         prevents agent from hallucinating re-calls of dropped tools)
  "drop_tool_structure": false,

  // Clear thinking/reasoning blocks older than 50 tags
  "clear_reasoning_age": 50,

  // Nudge agent after 15 consecutive turns without user input
  "iteration_nudge_threshold": 25,

  // Fix for qwen only allowing single system prompt
  "system_message_merge": true,

  // ── Historian ───────────────────────────────────────────────────────────

  "historian": {
    "model": "llamacpp/qwen-small",
    // "fallback_models": ["llamacpp/qwen3-full"],
    "temperature": 0.3,
    "two_pass": true,
    // Optional: custom system prompt for the historian
    // "prompt": "..."
  },

  // Timeout per historian call
  "historian_timeout_ms": 60000,

  // Fraction of usable context reserved for the history block.
  // 0.15 = 15% of (128k × execute_threshold). Triggers compression when exceeded.
  "history_budget_percentage": 0.15,

  // Inject compaction boundaries into opencode's DB after historian publishes.
  // Reduces transform input size for long sessions.
  "compaction_markers": true,

  // Historian trigger: fire when ≥3 commit clusters are unsummarized
  "commit_cluster_trigger": {
    "enabled": true,
    "min_clusters": 3
  },

  // ── Compressor ──────────────────────────────────────────────────────────
  // Background pass that merges older compartments when history block
  // exceeds its budget. Uses progressive caveman compression (5 depth tiers).
  "compressor": {
    "enabled": true,
    // Protect the 10 newest compartments from re-compression
    "grace_compartments": 10
    // max_merge_depth, max_compartments_per_pass, min_compartment_ratio
  },

  // ── Memory ──────────────────────────────────────────────────────────────
  "memory": {
    "enabled": true,
    // Token budget for injecting memories into <session-history>
    // 4000 is the default — fine for 128k
    "injection_budget_tokens": 4000,
    // Auto-promote session facts to project memories after historian runs
    "auto_promote": true,
    // How many retrievals before a fact is permanently promoted
    "retrieval_count_promotion_threshold": 3
  },

  // ── Embedding (for ctx_search semantic search) ───────────────────────────
  // "local" runs Xenova/all-MiniLM-L6-v2 in-process — no external DB needed.
  // Point at your llama-swap endpoint if you want a better embedding model.
  "embedding": {
    "provider": "local",           // "local" | "openai-compatible" | "off"
    "model": "Xenova/all-MiniLM-L6-v2"
    // For llama-swap embedding model:
    // "provider": "openai-compatible",
    // "endpoint": "http://localhost:8080/v1",
    // "model": "your-embedding-model-name"
  },

  // ── Sidekick ────────────────────────────────────────────────────────────
  // Fast context briefing agent, invoked via /ctx-aug at session start.
  "sidekick": {
    "enabled": true,
    "model": "llamacpp/qwen-small",
    // "fallback_models": ["llamacpp/qwen3-full"],
    "temperature": 0.2,
    "timeout_ms": 30000
  },

  // ── Dreamer ─────────────────────────────────────────────────────────────
  // Overnight maintenance: consolidates memories, verifies facts,
  // archives stale data. Runs in a scheduled window.
  "dreamer": {
    "enabled": true,              // set false if you don't leave machine on
    "model": "llamacpp/qwen-small",
    // "fallback_models": ["llamacpp/qwen3-full"],
    "temperature": 0.3,
    "schedule": "02:00-06:00",   // 24h format, supports overnight e.g. "23:00-05:00"
    "max_runtime_minutes": 120,
    "task_timeout_minutes": 20,
    "tasks": ["consolidate", "verify", "archive-stale", "improve"],
    "inject_docs": true,          // injects ARCHITECTURE.md + STRUCTURE.md if present

    // Extract behavioral observations about you across sessions
    "user_memories": {
      "enabled": true,
      "promotion_threshold": 3
    },

    // Pin frequently-read files into system prompt as <key-files> block
    "pin_key_files": {
      "enabled": false,
      "token_budget": 10000,
      "min_reads": 4
    }
  },

  // ── Experimental ────────────────────────────────────────────────────────
  "experimental": {
    // Surfaces wall-clock time gaps between messages to the agent.
    // Useful for reasoning about build times, log durations, etc.
    "temporal_awareness": true,

    // Index git commits for ctx_search ("when did we change X?")
    "git_commit_indexing": {
      "enabled": true,
      "since_days": 365,
      "max_commits": 2000
    },

    // Auto-append a vague memory hint to each user message when a
    // strong match is found in memory. Low cost (~200 tokens max).
    "auto_search": {
      "enabled": true,
      "score_threshold": 0.55,
      "min_prompt_chars": 20
    },

    // Heuristic caveman compression of old text parts.
    // Only active when ctx_reduce_enabled: false.
    "caveman_text_compression": {
      "enabled": false
    }
  }
}

