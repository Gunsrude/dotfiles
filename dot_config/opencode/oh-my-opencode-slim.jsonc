
{
  "preset": "local",

  "presets": {
    "local": {
      "orchestrator": {
        "model": "llamacpp/full",
        "temperature": 0.6,
        "skills": ["*"]
      },

      "oracle": {
        "model": "llamacpp/full",
        "temperature": 0.5,
        "skills": ["!websearch", "!grep_app"]
      },

      "designer": {
        "model": "llamacpp/full",
        "temperature": 0.7,
        "skills": ["*"]
      },

      "explorer": {
        "model": "llamacpp/small",
        "temperature": 0.3,
        "skills": ["!websearch", "!grep_app", "!context7"],
        "mcps": []
      },

      "librarian": {
        "model": "llamacpp/small",
        "temperature": 0.3,
        "skills": ["websearch", "context7", "grep_app"],
        "mcps": []
      },

      "fixer": {
        "model": "llamacpp/full",
        "temperature": 0.2,
        "skills": ["!websearch", "!grep_app", "!context7"],
        "mcps": []
      }
    }
  },

  "disabled_agents": ["observer", "council"],

  "sessionManager": {
    "readContextMinLines": 15,
    "readContextMaxFiles": 5
  },

  "fallback": {
    "enabled": true,
    "timeoutMs": 30000,
    "retryDelayMs": 1000,
    "retry_on_empty": true,
    "chains": {
      "explorer":  ["llamacpp/small", "llamacpp/full"],
      "librarian": ["llamacpp/small", "llamacpp/full"]
    }
  },

  "autoUpdate": false
}

