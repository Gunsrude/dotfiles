{
  "embeddingApiUrl": "http://llm.stellar.build:8080/v1",
  "embeddingApiKey": "none",
  "embeddingModel": "embed",
  "embeddingDimensions": 768,

  "memoryProvider": "openai-chat",
  "memoryModel": "qwen35-4b",
  "memoryApiUrl": "http://dumblm.stellar.build:8080/v1",
  "memoryApiKey": "none",
  "memoryTemperature": 0.3,

  "chatMessage": {
    "enabled": true,
    "maxMemories": 3,
    "injectOn": "first",
    "excludeCurrentSession": true
  },

  "compaction": {
    "enabled": true,
    "memoryLimit": 5
  },

  "autoCaptureEnabled": true,
  "autoCaptureMaxIterations": 3,
  "autoCaptureIterationTimeout": 45000,

  "autoCleanupEnabled": true,
  "autoCleanupRetentionDays": 60,
  "deduplicationEnabled": true,

  "showAutoCaptureToasts": true,
  "showUserProfileToasts": true,
  "showErrorToasts": true
}

