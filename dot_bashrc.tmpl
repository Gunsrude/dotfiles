
# SetOpts (bash equivalents using shopt)
shopt -s complete_aliases
shopt -s checkwinsize
shopt -s autocd
shopt -s cdable_vars
shopt -s dirspell
shopt -s expand_aliases

# History Settings
HISTFILE=~/.bash_history
HISTSIZE=10010
HISTFILESIZE=10000
HISTCONTROL=ignoreboth:erasedups
HISTIGNORE="&:ls:cd:exit:history"

# Completions
# Bash completion is typically sourced from /etc/bash_completion or similar
if [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
fi
complete -o nospace -C /usr/bin/vault vault

# MAKE environment
{{ if eq .chezmoi.os "linux" }}
MAKEFLAGS="-j$(nproc)"
{{ else }}
MAKEFLAGS="-j$(sysctl -n hw.ncpu)"
{{ end }}

{{- if not .is_container }}
{{- if eq .chezmoi.os "linux" }}
export SSH_AUTH_SOCK="$HOME/.local/share/ssh/ssh-agent.socket"
{{- end }}
export DOTFILES_REPO="https://github.com/Gunsrude/dotfiles.git"
{{- end }}

# Dotfiles stuffs
alias c=chezmoi

# docker stuff
dockerrm() {
    docker container stop "$1" && docker container rm "$1"
}

# Aliases
# env
{{- if eq .chezmoi.os "linux" }}
alias sdl="env -u SDL_VIDEODRIVER"
alias xforce="SDL_VIDEODRIVER=x11"
{{- end }}

# yay fixes
{{- if eq .chezmoi.os "linux" }}
alias yay='MAKEFLAGS="-j$(nproc)" yay --sudoloop'
alias mirrorup='sudo reflector --latest 20 --protocol https --sort rate --save /etc/pacman.d/mirrorlist -n 8 -c US --threads 8'
{{- end }}

{{ if eq .chezmoi.os "linux" }}
alias ls='ls --time-style=long-iso'
{{ else }}
alias ls='ls -lF'
{{ end }}
alias followthewhiterabbit="kitty --class kitty-matrix --config ~/.config/kitty/matrix.conf --start-as fullscreen -- tmatrix -f 0.1,2 -g 10,40"

# Wine32 Default
alias wine32='WINEPREFIX=~/.local/share/wineprefixes/win32 WINEARCH="win32"'

# Text Editor of choice
alias vi='nvim'
alias vim='nvim'
alias ni='nvim'
alias nano='nvim'
export EDITOR=nvim
alias :q='exit'
alias e='nvim .'
vsclear() {
    rm -f ~/.local/share/nvim/sessions/*
    rm -f ~/.local/state/nvim/sessions/*
    rm -rf ~/.cache/nvim
}

# Python
alias venv='python -m venv'

# Other Stuff
alias s='source "${HOME}/.bashrc"'
alias z='vim "${HOME}/.bashrc"'
alias neofetch='neofetch --color_blocks off'
alias powershell=pwsh
alias pwsh='pwsh /nologo'
mc() {
    mkdir "$1"
    cd "$1"
}
alias fucking='sudo'

fuck() {
  local app_name="$1"

  for i in $(ps aux | grep -i "$app_name" | grep -v grep | awk '{print $2}'); do
    sudo kill -9 "$i"
  done
}

# PATH
{{- if and (eq .chezmoi.os "darwin") (not .is_container) }}
if [ -d "/opt/homebrew/bin" ]; then export PATH="/opt/homebrew/bin:$PATH"; fi
if [ -d "${HOME}/Library/Python/3.9/bin" ]; then export PATH="${HOME}/Library/Python/3.9/bin:$PATH"; fi
{{- end }}
if [ -d "${HOME}/.local/bin" ]; then export PATH="${HOME}/.local/bin:$PATH"; fi
if [ -d "${HOME}/bin" ]; then export PATH="${HOME}/bin:$PATH"; fi

# Dummy API key for opencode-voice (ollama doesn't authenticate, but plugin requires a value)
export OLLAMA_API_KEY="ollama"

# Add workstation specific things like WSL settings
if [[ -f ~/.zshrc.local ]]; then
    source ~/.zshrc.local
fi

if [[ -d "$HOME/.nvm" ]]; then
    export NVM_DIR="$HOME/.nvm"
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
fi

# Opencode CLI
if [[ -d "$HOME/.opencode/bin" ]]; then
    export PATH="$HOME/.opencode/bin:$PATH"
fi

# Direnv
if [[ -x "$(command -v direnv)" ]]; then
    eval "$(direnv hook bash)"
fi
